# Copy to backend/.env and fill in values before running in any shared environment.

# Runtime environment marker: development | test | staging | production
ALLINO_ENV=development

# Required in staging/production: protects all ingestion endpoints with X-API-Key header.
# In development only, unauthenticated mode is allowed when
# ALLINO_ALLOW_INSECURE_DEV=true and ALLINO_API_KEY is unset.
ALLINO_API_KEY=change-me-in-production

# Optional JWT auth (Bearer token in Authorization header).
# If set, JWT is accepted as an alternative to X-API-Key.
# Keep unset if you only use API key auth.
#
# Symmetric (shared secret) verification:
# ALLINO_JWT_SECRET=change-me
# ALLINO_JWT_ALGORITHM=HS256
#
# Asymmetric verification (recommended, matches security baseline P0 BE-01):
# this service only verifies tokens issued by an external IdP, so only the
# public key is needed here, never a private key.
# ALLINO_JWT_ALGORITHM=RS256
# ALLINO_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----
#
# ALLINO_JWT_ISSUER=allino
# ALLINO_JWT_AUDIENCE=allino-api
# ALLINO_JWT_SYNC_ROLES=admin,operator
# ALLINO_JWT_SYNC_SCOPES=connectors:sync,sync:connectors
# ALLINO_JWT_READ_ROLES=admin,operator,analyst,viewer
# ALLINO_JWT_READ_SCOPES=ingestion:read,inbox:read,audit:read,metrics:read,connectors:read

# Development safety switch. Keep true only for local throwaway runs.
# Set false to require API key even in development.
ALLINO_ALLOW_INSECURE_DEV=false

# Comma-separated list of allowed CORS origins.
ALLINO_ALLOWED_ORIGINS=http://localhost:3000

# Feature-flagged event bus start path (Redis Streams).
# Enable only when Redis is reachable.
# ALLINO_EVENT_BUS_ENABLED=false
# Optional local async consumer worker baseline (in-process queue worker).
# ALLINO_EVENT_BUS_ASYNC_CONSUMER_ENABLED=false
# ALLINO_EVENT_BUS_ASYNC_TIMEOUT_SECONDS=5
# ALLINO_EVENT_BUS_ASYNC_MAX_ATTEMPTS=3
# Optional external worker mode (separate process via Redis request/result channels).
# ALLINO_EVENT_BUS_EXTERNAL_WORKER_ENABLED=false
# ALLINO_EVENT_BUS_EXTERNAL_WORKER_TIMEOUT_SECONDS=5
# ALLINO_EVENT_BUS_EXTERNAL_WORKER_MAX_ATTEMPTS=3
# ALLINO_EVENT_BUS_EXTERNAL_WORKER_BACKOFF_SECONDS=0.2
# ALLINO_EVENT_BUS_EXTERNAL_WORKER_DLQ_STREAM=allino:ingestion:dlq
# Optional fault-injection for strict DLQ smoke (staging only).
# If action_prefix starts with this value, external worker returns error and pushes to DLQ.
# ALLINO_EVENT_BUS_EXTERNAL_WORKER_FORCE_ERROR_ACTION_PREFIX=connector.zoom.sync
# ALLINO_REDIS_URL=redis://localhost:6379/0
# ALLINO_REDIS_STREAM_PREFIX=allino:ingestion

# In-memory rate limiting for ingestion/auth path.
# ALLINO_RATE_LIMIT_ENABLED=true
# ALLINO_RATE_LIMIT_REQUESTS=120
# ALLINO_RATE_LIMIT_WINDOW_SECONDS=60

# Security headers (CSP/HSTS and baseline browser hardening headers).
# ALLINO_SECURITY_HEADERS_ENABLED=true
# ALLINO_CSP_POLICY=default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'
# ALLINO_HSTS_ENABLED=true
# ALLINO_HSTS_MAX_AGE=31536000
# ALLINO_HSTS_INCLUDE_SUBDOMAINS=true
# ALLINO_HSTS_PRELOAD=false

# Field-level encryption at rest for sensitive persisted strings.
# In production, provide ALLINO_ENCRYPTION_KEY when encryption is enabled.
# ALLINO_ENCRYPTION_AT_REST_ENABLED=true
# ALLINO_ENCRYPTION_KEY=change-me-32-plus-chars

# Optional Vault-backed secrets (KV v2). Env vars still have priority.
# If enabled, secrets are read from: {ALLINO_VAULT_ADDR}/v1/{ALLINO_VAULT_MOUNT}/data/{ALLINO_VAULT_PATH}
# using key names matching ALLINO_* secret env var names.
# ALLINO_VAULT_ENABLED=false
# ALLINO_VAULT_ADDR=http://localhost:8200
# ALLINO_VAULT_TOKEN=change-me
# ALLINO_VAULT_MOUNT=secret
# ALLINO_VAULT_PATH=allino

# Connector runtime readiness flags (capabilities endpoint). Each token below is
# resolved env-first, Vault-fallback (core/secrets.py), same as every other secret
# in this project. Manual sync via the API can also pass a token per-request via
# the X-Connector-Token header instead of setting it here -- but the scheduler
# worker's auto-poll (ALLINO_BUILTIN_CONNECTORS_POLL_* below) has no per-request
# header to fall back on, so a source needs its token set here to ever be
# auto-polled.
# ALLINO_GITHUB_TOKEN=github-personal-access-token
# ALLINO_GITLAB_TOKEN=gitlab-personal-access-token
# ALLINO_GITLAB_BASE_URL=https://gitlab.com
# ALLINO_JIRA_TOKEN=atlassian-api-token
# ALLINO_JIRA_BASE_URL=https://your-domain.atlassian.net
# ALLINO_LINEAR_TOKEN=linear-api-key
# ALLINO_TELEGRAM_BOT_TOKEN=telegram-bot-token
# ALLINO_SLACK_BOT_TOKEN=slack-bot-token
# ALLINO_SLACK_CHANNEL_ID=C0123456789
# ALLINO_DISCORD_BOT_TOKEN=discord-bot-token
# ALLINO_DISCORD_CHANNEL_ID=123456789012345678
# ALLINO_ZOOM_TOKEN=zoom-oauth-token
# ALLINO_TEAMS_TOKEN=microsoft-graph-token
# ALLINO_GOOGLE_CALENDAR_TOKEN=google-oauth-access-token
# Rocket.Chat REST API auth is a token+user-id pair (personal access token or
# bot user), not a single bearer token. Self-hosted, so base_url is required
# too (no universal default like gitlab.com).
# ALLINO_ROCKETCHAT_TOKEN=rocketchat-auth-token
# ALLINO_ROCKETCHAT_USER_ID=rocketchat-user-id
# ALLINO_ROCKETCHAT_BASE_URL=https://chat.example.com
# ALLINO_ROCKETCHAT_CHANNEL_ID is OPTIONAL. Leave it unset to watch every
# room the above user belongs to (via subscriptions.get -- needs no admin
# rights, just your own personal token), or set it to a specific Room ID
# (not a channel name) to poll just that one room instead.
# ALLINO_ROCKETCHAT_CHANNEL_ID=GENERAL

# Generic HTTP Connector + Webhook Receiver (CLAUDE.md section 5): each connector
# instance is registered via POST /api/v1/ingestion/connectors/generic with a name,
# which is slugified (lowercase, non-alnum -> '-'). Secrets are never stored in the
# DB config row — resolve them here (or in Vault) using the slug in SCREAMING_SNAKE
# form (hyphens become underscores):
# ALLINO_GENERIC_{SLUG}_TOKEN=api-token-for-polling-auth
# ALLINO_GENERIC_{SLUG}_WEBHOOK_SECRET=hmac-secret-for-POST-/webhooks/{connector_id}
# Example: a connector named "My Jenkins" -> slug "my-jenkins" ->
# ALLINO_GENERIC_MY_JENKINS_TOKEN / ALLINO_GENERIC_MY_JENKINS_WEBHOOK_SECRET
#
# Optional: only needed for webhook providers that require a subscription
# handshake before they'll start sending events (e.g. WhatsApp Business Cloud
# API / Meta Graph API webhooks: GET /webhooks/{connector_id}?hub.mode=subscribe
# &hub.verify_token=...&hub.challenge=...). If set, that GET echoes back
# hub.challenge once hub.verify_token matches; if unset, the GET 404s (same as
# before this existed) and only the POST path is used, as with any other
# generic webhook source.
# ALLINO_GENERIC_{SLUG}_WEBHOOK_VERIFY_TOKEN=verify-token-you-chose-in-metas-app-dashboard
#
# Optional field_mapping.items_path: for sources whose items are nested deeper
# than a top-level array or an "items"/"data"/"results" key (e.g. WhatsApp
# Business Cloud API's "entry[].changes[].value.messages[]" — each "[]"-suffixed
# segment iterates and flattens one array level). Viber's webhook payload is a
# single flat event object per call, so no items_path is needed for it at all.

# Path to the SQLite database file. Defaults to backend/data/allino.db.
# ALLINO_DB_PATH=/path/to/allino.db

# Scheduler worker (backend/app/workers/scheduler_worker.py): in-process tick rate for
# checking which connectors are due for an automatic poll (not per-connector interval).
# ALLINO_SCHEDULER_WORKER_POLL_INTERVAL_SECONDS=30

# Optional Google Calendar auto-polling via the scheduler worker. Built-in connectors
# (unlike Generic HTTP Connectors) have no persisted per-tenant config table, so this
# is scoped to a single tenant/calendar via env, not a DB-driven list of tenants.
# Requires ALLINO_GOOGLE_CALENDAR_TOKEN (above) to actually fetch anything.
# ALLINO_GOOGLE_CALENDAR_POLL_ENABLED=false
# ALLINO_GOOGLE_CALENDAR_POLL_INTERVAL_SECONDS=900
# ALLINO_GOOGLE_CALENDAR_POLL_TENANT_ID=tenant_demo
# ALLINO_GOOGLE_CALENDAR_POLL_CALENDAR_ID=primary

# Optional auto-polling for the other built-in named connectors (GitHub, GitLab,
# Jira, Linear, Telegram, Slack, Discord, Zoom, Teams, Rocket.Chat) via the
# scheduler worker. Same env-scoped-to-a-single-tenant shape as Google Calendar
# polling above. A connector is only attempted if its token (above) is actually
# configured -- unconfigured ones are silently skipped, not treated as an error.
# ALLINO_BUILTIN_CONNECTORS_POLL_ENABLED=false
# ALLINO_BUILTIN_CONNECTORS_POLL_INTERVAL_SECONDS=300
# ALLINO_BUILTIN_CONNECTORS_POLL_TENANT_ID=tenant_demo

# Admin MFA (CLAUDE.md section 4 "MFA for admin paths"): destructive admin
# actions (currently: deleting all of a tenant's messages) require a valid
# TOTP code in addition to normal auth (API key or JWT with the admin
# role/scope) -- the TOTP check applies even to API-key callers, which are
# otherwise fully trusted everywhere else in this API. Roles/scopes:
# ALLINO_JWT_ADMIN_ROLES=admin
# ALLINO_JWT_ADMIN_SCOPES=admin:destructive,tenant:delete
#
# The TOTP secret is env/Vault-only, like every other secret in this project --
# there is deliberately no server endpoint/web UI for enrollment (an endpoint
# that could hand back the raw seed would let any caller self-enroll a device
# and permanently bypass the second factor). Instead, generate and scan it
# entirely locally with:
#   python scripts/generate_admin_totp_qr.py
# (prints the secret + an ASCII QR code to scan; pass --output some.png to save
# a PNG instead, or --secret to re-render an existing secret you already have).
# Then set the printed secret here and restart the backend. You can still type
# the base32 secret into an authenticator app by hand instead of scanning, too.
# ALLINO_ADMIN_TOTP_SECRET=change-me-base32-secret
